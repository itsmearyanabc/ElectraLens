# /etc/electralens/anchor.env on the VPS (root:root, chmod 600). Only the anchor service reads it:
# it alone holds the publisher key. Names only: never commit values.

ANCHOR_HMAC_KEY=
# The publisher hot wallet (testnet only), NOT a personal wallet. Paste from the secrets file.
PUBLISHER_PRIVATE_KEY=
RPC_URL=https://ethereum-hoodi-rpc.publicnode.com
CHAIN_ID=560048
CHAIN_NETWORK=hoodi
REGISTRY_ADDRESS=
REGISTRY_DEPLOY_BLOCK=
CONFIRMATIONS=1
SUPABASE_URL=
SUPABASE_SECRET_KEY=
RECONCILE_INTERVAL_MS=600000
MIN_BALANCE_WEI=10000000000000000
