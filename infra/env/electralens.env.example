# /etc/electralens/electralens.env on the VPS (root:root, chmod 600). Names only: fill in on the
# server, never commit values. Read by the website, the API and the worker through --env-file.

# ---- site -----------------------------------------------------------------------------------
APP_ORIGIN=https://electralens.armedias.com
API_INTERNAL_URL=http://127.0.0.1:4100

# ---- Supabase (cloud project) ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Session pooler (IPv4), used by the worker only.
DATABASE_URL=

# ---- chain (read-only values for the browser verifier) ---------------------------------------
NEXT_PUBLIC_CHAIN_ID=560048
NEXT_PUBLIC_RPC_URL=https://ethereum-hoodi-rpc.publicnode.com
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_EXPLORER_URL=https://hoodi.etherscan.io

# ---- API ------------------------------------------------------------------------------------
# Shared with anchor.env: generate once with  openssl rand -hex 32
ANCHOR_HMAC_KEY=
ANCHOR_URL=http://127.0.0.1:4200
# openssl rand -hex 16
IP_HASH_SALT=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 1 skips the Turnstile check when no secret is set (prototype demo); rate limits still apply.
TURNSTILE_DISABLED=1

# ---- worker ---------------------------------------------------------------------------------
WORKER_ID=vps-worker-1
POLL_INTERVAL_MS=3000
# Written by infra/scripts/deploy.sh on every deploy.
ELECTRALENS_GIT_SHA=

# ---- staff accounts (read only by apps/api/dist/bootstrap.js) ---------------------------------
# Passwords: at least 14 characters. Each account sets up an authenticator app at first sign-in.
ELECTRALENS_ADMIN_EMAIL=
ELECTRALENS_ADMIN_PASSWORD=
# Optional demo staff: the two-person rule needs different people for each step.
ELECTRALENS_DATA_STEWARD_EMAIL=
ELECTRALENS_DATA_STEWARD_PASSWORD=
ELECTRALENS_ANALYST_EMAIL=
ELECTRALENS_ANALYST_PASSWORD=
ELECTRALENS_REVIEWER_EMAIL=
ELECTRALENS_REVIEWER_PASSWORD=
ELECTRALENS_PUBLISHER_EMAIL=
ELECTRALENS_PUBLISHER_PASSWORD=
