{
  "name": "@electralens/api",
  "version": "0.1.0",
  "private": true,
  "description": "ElectraLens API: public reads, claims, citizen accounts and staff actions that need a secret.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electralens/anchor": "workspace:*",
    "@electralens/claims": "workspace:*",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@supabase/supabase-js": "2.118.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "openapi-types": "12.1.3",
    "vitest": "5.0.5"
  }
}
