{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@electralens/database": ["../../packages/schemas/src/database.types.ts"],
      "@/*": ["./*"],
      "@electralens/canon": ["../../packages/canon/src/index.ts"],
      "@electralens/schemas": ["../../packages/schemas/src/index.ts"],
      "@electralens/i18n": ["../../packages/i18n/src/index.ts"],
      "@electralens/claims": ["../../packages/claims/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
