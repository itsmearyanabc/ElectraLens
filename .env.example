# ElectraLens environment template (see docs/05-TECHNICAL-ARCHITECTURE.md §2).
# Copy to .env for local development. NEVER put real secrets in this file or in Git.
# In production, secrets are Docker secret files; services read the *_FILE variants.

# ---------- Shared ----------
APP_ORIGIN=http://localhost:3100
SUPABASE_URL=
# Supabase API keys: publishable (sb_publishable_…, public) replaces the old anon key;
# secret (sb_secret_…, server only) replaces the old service_role key.
SUPABASE_PUBLISHABLE_KEY=
CHAIN_ID=560048
RPC_URL=
REGISTRY_ADDRESS=
REGISTRY_DEPLOY_BLOCK=

# ---------- web (public values only: these end up in the browser) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=560048
API_INTERNAL_URL=http://localhost:4100

# ---------- api (secret) ----------
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
ANCHOR_URL=http://localhost:4200
ANCHOR_HMAC_KEY=
# none | gemini | ollama  (off by default, decision D6)
LLM_PROVIDER=none
LLM_API_KEY=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ---------- anchor (secret) ----------
# Dedicated testnet publisher wallet. Never a personal wallet key.
PUBLISHER_PRIVATE_KEY=
CONFIRMATIONS=1

# ---------- worker (secret) ----------
# Supavisor session pooler connection string (IPv4).
DATABASE_URL=
WORKER_ID=worker-local
POLL_INTERVAL_MS=3000
