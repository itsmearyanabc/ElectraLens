{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:electralens:schema:manifest_v1",
  "title": "manifest_v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "electralens.manifest.v1"
    },
    "series_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_manifest_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "datasets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": ["baseline", "target", "booths"]
          },
          "version_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "root": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "row_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "schema": {
            "type": "string",
            "enum": ["electoral_roll_v1", "polling_stations_v1"]
          },
          "canon": {
            "type": "string",
            "const": "elcanon-1"
          }
        },
        "required": ["role", "version_id", "root", "row_count", "schema", "canon"],
        "additionalProperties": false
      }
    },
    "audit_run": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "engine": {
              "type": "string",
              "pattern": "^git:[0-9a-f]{7,40}$"
            },
            "image": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "methodology": {
              "type": "string",
              "pattern": "^[0-9]{4}\\.[0-9]+$"
            },
            "params_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["id", "engine", "image", "methodology", "params_hash"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "report_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregates_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "schema",
    "series_id",
    "sequence",
    "previous_manifest_hash",
    "is_synthetic",
    "datasets",
    "audit_run",
    "report_hash",
    "aggregates_hash",
    "published_at",
    "publisher"
  ],
  "additionalProperties": false
}
