{
  "name": "@electralens/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for ElectraLens data contracts (zod), exported as JSON Schema for the Python engine.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json/*": "./json/*"
  },
  "files": [
    "dist",
    "json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate-json-schema.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
