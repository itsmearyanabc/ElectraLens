{
  "name": "@electralens/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Translation catalogues, explanation templates and the template renderer shared with the Python engine.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalogue/*": "./catalogue/*",
    "./banned-terms.json": "./banned-terms.json"
  },
  "files": [
    "dist",
    "catalogue",
    "banned-terms.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
