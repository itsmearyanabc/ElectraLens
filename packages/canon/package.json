{
  "name": "@electralens/canon",
  "version": "0.1.0",
  "private": true,
  "description": "Canonicalisation elcanon-1, salted RFC 6962 Merkle trees and document hashing. Runs in Node and the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electralens/schemas": "workspace:*",
    "@noble/hashes": "2.4.0",
    "canonicalize": "5.1.0"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
